# OpenCode binary. Optional: dso auto-detects common install locations.
# DSO_OPENCODE_BIN=/usr/local/bin/opencode

# Use a private server per run (default 1). Set 0 to reuse the shared service.
DSO_STANDALONE=1

# Provider credentials are read by the OpenCode CLI, not by dso.
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
